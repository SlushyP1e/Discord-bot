# Required — your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=paste-your-token-here

# Optional — a server (guild) ID. When set, slash commands register to that
# server instantly instead of globally (global can take up to an hour the
# first time). Great while testing; remove for production.
#GUILD_ID=123456789012345678

# Optional — your Discord user ID. This is the only account allowed to block
# GIFs and to configure the AI (/aiconfig). If left unset, the bot auto-detects
# the Discord application's owner (i.e. you), so you normally don't need this.
#OWNER_ID=123456789012345678

# ── /ask — AI brain (all optional) ───────────────────────────────────────────
# You do NOT need any of these: the owner sets the API key at runtime with
# /aiconfig key, which stores it in the database. These are just the defaults
# used before/until that happens.
#
# Defaults point at DeepSeek. Any OpenAI-compatible provider works, e.g.:
#   OpenAI      AI_BASE_URL=https://api.openai.com/v1       AI_MODEL=gpt-4o-mini
#   Groq        AI_BASE_URL=https://api.groq.com/openai/v1  AI_MODEL=llama-3.3-70b-versatile
#   OpenRouter  AI_BASE_URL=https://openrouter.ai/api/v1    AI_MODEL=deepseek/deepseek-chat
#AI_PROVIDER=deepseek
#AI_BASE_URL=https://api.deepseek.com
# deepseek-v4-flash is the cheap one. (The old deepseek-chat / deepseek-reasoner
# names were retired on 2026-07-24 and no longer work.)
#AI_MODEL=deepseek-v4-flash
#AI_API_KEY=

# Strongly recommended — a random passphrase used to encrypt the API key at
# rest (AES-256-GCM) once /aiconfig key saves it. Without it the key is stored
# in the database as plain text. Changing it later means re-running /aiconfig key.
#CONFIG_SECRET=

# Optional extra personality notes bolted onto the built-in persona. The safety
# rules always apply regardless. Can also be set live with /aiconfig persona.
#AI_PERSONA=

# Chat by @mentioning the bot or replying to its messages, as well as /ask.
# REQUIRES the privileged "Message Content" intent: Developer Portal → your app
# → Bot → Privileged Gateway Intents → Message Content Intent → Save. Turning
# this on WITHOUT enabling that intent stops the bot from starting at all.
# Same rules as /ask: allow-listed servers only, and DMs are owner-only.
#AI_MENTION_CHAT=false

# Log to the console why a mention was ignored. Mention refusals are silent in
# Discord on purpose, so switch this on when "it won't reply" and check the logs.
#AI_DEBUG=false

# Optional tuning for AI replies. Lower AI_MAX_TOKENS and AI_MEMORY_TURNS = cheaper.
#AI_TIMEOUT_MS=30000
# Higher = more creative, and noticeably more theatrical. Above ~0.9 she starts
# writing roleplay actions instead of answering.
#AI_TEMPERATURE=0.7
# Hard cap on reply length. 400 ≈ 300 words, plenty for chat.
#AI_MAX_TOKENS=400
# Past messages resent as context on each /ask. Fewer = fewer input tokens.
#AI_MEMORY_TURNS=8
# DeepSeek's V4 models think by default and bill those reasoning tokens as
# output. 'auto' (the default) switches thinking off on DeepSeek and sends
# nothing at all to other providers. Use 'enabled' for smarter-but-pricier
# replies, or 'omit' to never send the field.
#AI_THINKING=auto
